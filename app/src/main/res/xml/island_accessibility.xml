<?xml version="1.0" encoding="utf-8"?>
<!--
    canTakeScreenshot: the island looks at the screen just around itself to tell whether everything there is black,
    and only then draws its faint grey outline. Nothing is saved or sent anywhere.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/island_accessibility_description"
    android:notificationTimeout="100" />
